# ─────────────────────────────────────────────────────────────────────────────
# Text Humanize — Apache configuration
# HTML files are generated by `node tools/build.mjs` (sources live in /src).
# ─────────────────────────────────────────────────────────────────────────────

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType text/javascript .js
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddCharset utf-8 .html .css .js .txt .xml .json

# ── Private files ────────────────────────────────────────────────────────────
<FilesMatch "^(\.env.*|\.gitignore|\.DS_Store|.*\.md|package(-lock)?\.json|router\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

RewriteEngine On

# ── One canonical host: www → apex (checked first so http://www is a single hop) ──
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ── HTTPS ────────────────────────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Old programmatic /tools/* pages → homepage (also keeps the build folder private) ──
RewriteRule ^tools(/.*)?$ / [R=301,L]

# ── Block source, storage and non-endpoint PHP ───────────────────────────────
# ── Redirect or block source, storage, templates and non-endpoint PHP ────────
RewriteRule ^(src|storage)(/.*)?$ / [R=301,L]
RewriteRule ^(\.git|\.claude)(/|$) - [F,L]
RewriteRule ^blog/@@SLUG@@/?$ /blog/ [R=301,L]
RewriteRule ^feed(\.xml)?$ /blog/feed.xml [R=301,L]
RewriteRule ^rss(\.xml)?$ /blog/feed.xml [R=301,L]
RewriteRule ^blog/feed$ /blog/feed.xml [R=301,L]
# plagiarism.php (paid Copyleaks scans) is no longer used by the UI; remove it from this list to re-enable.
RewriteRule ^api/(lib/|config\.php|rate_limit\.php|warm-cache\.php|plagiarism\.php) - [F,L]

# ── Retired and merged pages → closest current page ──────────────────────────
RewriteRule ^methodology(\.html)?$ /how-it-works [R=301,L]
RewriteRule ^blog/write-college-essay-ai(\.html)?$ /blog/responsible-ai-use-for-students [R=301,L]
RewriteRule ^blog/bypass-turnitin-ai-detection(\.html)?$ /blog/ai-detector-false-positives [R=301,L]
RewriteRule ^blog/turnitin-ai-detection(\.html)?$ /blog/ai-detector-false-positives [R=301,L]
RewriteRule ^blog/how-to-bypass-ai-detection(\.html)?$ /blog/how-ai-detection-works [R=301,L]
RewriteRule ^blog/gptzero-vs-turnitin(\.html)?$ /blog/how-ai-detection-works [R=301,L]
RewriteRule ^blog/does-grammarly-detect-ai(\.html)?$ /blog/how-ai-detection-works [R=301,L]
RewriteRule ^blog/best-ai-detection-removers(\.html)?$ /blog/how-to-edit-ai-writing [R=301,L]
RewriteRule ^blog/best-ai-humanizer-tools(\.html)?$ /blog/best-ai-humanizers [R=301,L]
RewriteRule ^blog/undetectable-ai-review(\.html)?$ /blog/is-undetectable-ai-legit [R=301,L]
RewriteRule ^blog/quillbot-review(\.html)?$ /blog/how-to-edit-ai-writing [R=301,L]
RewriteRule ^blog/best-free-ai-humanizer-no-word-limit(\.html)?$ / [R=301,L]
RewriteRule ^blog/ai-text-to-human-converter(\.html)?$ /how-it-works [R=301,L]
RewriteRule ^blog/humanize-chatgpt-text(\.html)?$ /blog/how-to-make-chatgpt-sound-more-human [R=301,L]
RewriteRule ^blog/argumentative-essay-ai-guide(\.html)?$ /blog/how-to-write-argumentative-essay [R=301,L]
RewriteRule ^blog/ai-vs-human-writing(\.html)?$ /blog/common-ai-writing-patterns [R=301,L]
RewriteRule ^blog/free-ai-detector(\.html)?$ /ai-detector [R=301,L]
RewriteRule ^blog/(humanizing-chatgpt-essays|does-safeassign-detect-ai|can-canvas-detect-chatgpt|free-ai-writing-tools-students)(\.html)?$ /blog/responsible-ai-use-for-students [R=301,L]
RewriteRule ^blog/bypass-originality-ai-detection(\.html)?$ /bypass-originality [R=301,L]
RewriteRule ^blog/how-to-bypass-copyleaks-ai-detection(\.html)?$ /bypass-copyleaks [R=301,L]

# ── Canonical clean URLs ─────────────────────────────────────────────────────
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]

RewriteCond %{THE_REQUEST} !google[a-z0-9]+\.html [NC]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

RewriteCond %{REQUEST_URI} ^/blog$
RewriteRule ^ /blog/ [R=301,L]

# ── Posts written at /admin (cms/) ───────────────────────────────────────────
# The built guides always win: a request only reaches cms/post.php when no blog/<slug>.html exists.
RewriteRule ^cms/lib(/|$) - [F,L]
RewriteRule ^admin/?$ cms/admin.php [L,QSA]
RewriteRule ^blog/feed\.xml$ cms/feed.php [L]
RewriteRule ^sitemap-posts\.xml$ cms/sitemap.php [L]
RewriteRule ^blog/$ cms/blog.php [L]

# Serve extensionless URLs from .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^blog/([a-z0-9][a-z0-9-]*)$ cms/post.php?slug=$1 [L,QSA]

# ── Security & caching headers ───────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # Google AdSense, consent messaging and Analytics load from many Google hosts,
  # so scripts, frames and connections allow HTTPS origins generally.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-src https:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

  # CSS/JS are referenced with a content hash (?v=…) by the build, so they can be cached for a year.
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

# ── Compression ──────────────────────────────────────────────────────────────
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml
</IfModule>
